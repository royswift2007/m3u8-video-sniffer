# Python 编译缓存
__pycache__/
*.pyc
*.pyo
*.pyd

# PyInstaller 打包产生的中间文件和最终产物
build/
dist/
*.spec

# 外部二进制工具（如果不需要存入仓库的话）
bin/
*.exe
*.zip

# 虚拟环境
venv/
.venv/
env/

# 编辑器配置
.vscode/
.idea/

# ISS-49: 补全忽略规则
# 临时目录
Temp/
temp/

# 运行时日志
logs/

# pytest 缓存
.pytest_cache/

# mypy / pyright 缓存
.mypy_cache/
.pyright/

# 备份文件
*.bak

# 调试残留
missing*.txt
*.lnk

# OS 生成文件
Thumbs.db
Desktop.ini
.DS_Store